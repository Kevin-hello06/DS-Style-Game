; Engine configuration file.
; Edit through Project > Project Settings in the Godot editor where possible.

config_version=5

[application]

config/name="Fold Adventure"
config/description="A small top-down action-adventure prototype built for the Galaxy Z Fold."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[display]

; Low base resolution for crisp pixel art. "expand" lets the camera show more
; of the world on wider/squarer screens instead of letterboxing, so the game
; adapts when the Fold opens or closes. Integer scaling keeps pixels sharp.
window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
; 6 = sensor: follows the phone in any orientation (cover screen or inner screen).
window/handheld/orientation=6

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
